# --- Supabase (Project settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# --- Postgres (Project settings → Database → Connection string) ---
# Runtime: transaction pooler, port 6543
DATABASE_URL=postgres://postgres.xxxx:PASSWORD@aws-0-ca-central-1.pooler.supabase.com:6543/postgres
# Migrations only: session pooler (5432) or direct connection
MIGRATION_DATABASE_URL=postgres://postgres.xxxx:PASSWORD@aws-0-ca-central-1.pooler.supabase.com:5432/postgres

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- AI (phase 2) — server only, never prefixed NEXT_PUBLIC ---
ANTHROPIC_API_KEY=
# Optional
OPENAI_API_KEY=
AI_MODEL_ANTHROPIC=claude-sonnet-5-5
AI_MODEL_OPENAI=gpt-5

# --- Local development only. Ignored on Vercel. ---
# MVMNT_DEV_AUTH=1
# DEV_AUTH_SECRET=change-me-32-chars-minimum-xxxxxxxxx

# --- Notifications (phase 3) ---
# Generate once with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:toi@exemple.com
# Long random string; also used in supabase/cron-reminders.sql
CRON_SECRET=
